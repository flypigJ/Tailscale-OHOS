--- /dev/null
+++ b/tsnet/mesharc_dns.go
@@ -0,0 +1,23 @@
+package tsnet
+
+import (
+	"errors"
+	"net"
+)
+
+type dnsConfigRecompiler interface{ RecompileDNSConfig() error }
+
+// RecompileDNSConfig refreshes a successfully initialized engine's DNS base.
+// It never starts a server. Close waits for in-flight recompilation without
+// holding s.mu, which is also acquired by callbacks from the network stack.
+func (s *Server) RecompileDNSConfig() error {
+	s.dnsOpMu.Lock()
+	defer s.dnsOpMu.Unlock()
+	if s.dnsClosing {
+		return net.ErrClosed
+	}
+	if s.dnsRecompiler == nil {
+		return errors.New("tsnet: DNS not ready")
+	}
+	return s.dnsRecompiler.RecompileDNSConfig()
+}
--- /dev/null
+++ b/tsnet/mesharc_dns_test.go
@@ -0,0 +1,27 @@
+package tsnet
+
+import (
+	"errors"
+	"net"
+	"testing"
+)
+
+type dnsTestRecompiler struct{ calls int }
+
+func (d *dnsTestRecompiler) RecompileDNSConfig() error { d.calls++; return nil }
+
+func TestMeshArcDNSDoesNotStartServer(t *testing.T) {
+	s := &Server{}
+	if s.RecompileDNSConfig() == nil || s.sys != nil || s.lb != nil {
+		t.Fatal("uninitialized DNS request started a server")
+	}
+	r := &dnsTestRecompiler{}
+	s.dnsRecompiler = r
+	if err := s.RecompileDNSConfig(); err != nil || r.calls != 1 {
+		t.Fatal("ready manager was not recompiled")
+	}
+	s.dnsClosing, s.dnsRecompiler = true, nil
+	if !errors.Is(s.RecompileDNSConfig(), net.ErrClosed) || r.calls != 1 {
+		t.Fatal("closed server allowed DNS work")
+	}
+}
