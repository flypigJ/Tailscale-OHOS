+func TestD3ExitAndRecompileProvenance(t *testing.T) {
+	root, split := d3Serve(t, false), d3Serve(t, true)
+	m, os := d3Manager(t, root, split)
+	cfg := d3Config(split)
+	for _, exit := range []bool{false, true, false} {
+		cfg.UsingExitNode = exit
+		rc, _, err := m.compileConfig(cfg)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if got := rc.Routes["."][0].UsesPhysicalNetwork(); got == exit {
+			t.Fatalf("exit=%v physical=%v", exit, got)
+		}
+		if !os.BaseConfig.Resolvers[0].UsesPhysicalNetwork() {
+			t.Fatal("compiler mutated base resolver")
+		}
+	}
+	if err := m.Set(cfg); err != nil {
+		t.Fatal(err)
+	}
+	// Reuse the already-allowed split server as the new public base.
+	os.setBaseConfig(OSConfig{Resolvers: []*dnstype.Resolver{dnstype.PhysicalNetworkResolver(&dnstype.Resolver{Addr: split.addr})}})
+	if err := m.RecompileDNSConfig(); err != nil {
+		t.Fatal(err)
+	}
+	p, e := d3Query(m, "changed.public.test.", dns.TypeA, "udp")
+	if e != nil || p.RCode != 0 || split.count("changed.public.test.") == 0 || root.count("changed.public.test.") != 0 {
+		t.Fatalf("base recompile failed: %v", e)
+	}
+	cfg.SearchDomains = []dnsname.FQDN{"new.magic.test."}
+	if err := m.Set(cfg); err != nil {
+		t.Fatal(err)
+	}
+	if len(os.OSConfig.SearchDomains) != 1 || os.OSConfig.SearchDomains[0] != "new.magic.test." {
+		t.Fatal("search-domain projection did not change")
+	}
+}
