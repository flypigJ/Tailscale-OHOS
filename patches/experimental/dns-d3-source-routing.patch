+package dnstype
+
+// PhysicalNetworkResolver clones r and marks it as originating from local OS DNS.
+// Only trusted OS configuration adapters should call this constructor.
+func PhysicalNetworkResolver(r *Resolver) *Resolver {
+	if r == nil {
+		return nil
+	}
+	out := r.Clone()
+	out.physicalNetwork = true
+	return out
+}
+
+func (r *Resolver) UsesPhysicalNetwork() bool { return r != nil && r.physicalNetwork }
+
+// WithoutPhysicalNetwork preserves the original routing policy when an exit is selected.
+func (r *Resolver) WithoutPhysicalNetwork() *Resolver {
+	if r == nil {
+		return nil
+	}
+	out := r.Clone()
+	out.physicalNetwork = false
+	return out
+}
