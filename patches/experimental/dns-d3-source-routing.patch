+func TestD3DoHUsesSourceDialer(t *testing.T) {
+	const name = "https.public.test."
+	request := makeTestRequest(t, name, dns.TypeA, 0)
+	response := makeTestResponse(t, name, dns.RCodeSuccess, netip.MustParseAddr("192.0.2.9"))
+	var received atomic.Int32
+	server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		q, err := io.ReadAll(r.Body)
+		if err != nil || !bytes.Equal(q, request) {
+			t.Error("DoH fixture received wrong query")
+			w.WriteHeader(400)
+			return
+		}
+		received.Add(1)
+		w.Header().Set("Content-Type", "application/dns-message")
+		_, _ = w.Write(response)
+	}))
+	defer server.Close()
+	bus := eventbustest.NewBus(t)
+	mon := netmon.NewStatic()
+	d := tsdial.NewDialer(mon)
+	d.SetBus(bus)
+	defer d.Close()
+	var physical, tailnet atomic.Int32
+	target := server.Listener.Addr().String()
+	dial := func(ctx context.Context, n, a string) (net.Conn, error) {
+		if a != target {
+			return nil, fmt.Errorf("external DoH forbidden: %s", a)
+		}
+		return new(net.Dialer).DialContext(ctx, n, a)
+	}
+	d.SetSystemDialerForTest(func(ctx context.Context, n, a string) (net.Conn, error) { physical.Add(1); return dial(ctx, n, a) })
+	d.UseNetstackForIP = func(ip netip.Addr) bool { return ip.IsLoopback() }
+	d.NetstackDialUDP = func(context.Context, netip.AddrPort) (net.Conn, error) {
+		return nil, fmt.Errorf("unexpected UDP in DoH test")
+	}
+	d.NetstackDialTCP = func(ctx context.Context, a netip.AddrPort) (net.Conn, error) {
+		tailnet.Add(1)
+		return dial(ctx, "tcp4", a.String())
+	}
+	f := newForwarder(t.Logf, mon, nil, d, health.NewTracker(bus), nil)
+	defer f.Close()
+	certs := x509.NewCertPool()
+	certs.AddCert(server.Certificate())
+	for _, local := range []bool{false, true} {
+		r := &dnstype.Resolver{Addr: server.URL + "/dns-query"}
+		if local {
+			r = dnstype.PhysicalNetworkResolver(r)
+		}
+		c, ok := f.getDoHClientForResolver(r)
+		if !ok {
