+func TestD3SameAddressDifferentNetwork(t *testing.T) {
+	const name = "network.private.test."
+	request := makeTestRequest(t, name, dns.TypeA, 0)
+	response := makeTestResponse(t, name, dns.RCodeSuccess, netip.MustParseAddr("192.0.2.9"))
+	port := runDNSServer(t, nil, response, func(bool, []byte) {})
+	target := netip.AddrPortFrom(netip.MustParseAddr("127.0.0.1"), port)
+	bus := eventbustest.NewBus(t)
+	mon := netmon.NewStatic()
+	d := tsdial.NewDialer(mon)
+	d.SetBus(bus)
+	t.Cleanup(func() { _ = d.Close() })
+	var physical, tailnet atomic.Int32
+	dial := func(ctx context.Context, network, addr string) (net.Conn, error) {
+		if addr != target.String() {
+			return nil, fmt.Errorf("external DNS forbidden: %s", addr)
+		}
+		return new(net.Dialer).DialContext(ctx, network, addr)
+	}
+	d.SetSystemDialerForTest(func(ctx context.Context, n, a string) (net.Conn, error) { physical.Add(1); return dial(ctx, n, a) })
+	d.UseNetstackForIP = func(ip netip.Addr) bool { return ip == target.Addr() }
+	d.NetstackDialUDP = func(ctx context.Context, a netip.AddrPort) (net.Conn, error) {
+		tailnet.Add(1)
+		return dial(ctx, "udp4", a.String())
+	}
+	d.NetstackDialTCP = func(ctx context.Context, a netip.AddrPort) (net.Conn, error) {
+		tailnet.Add(1)
+		return dial(ctx, "tcp4", a.String())
+	}
+	f := newForwarder(t.Logf, mon, nil, d, health.NewTracker(bus), nil)
+	t.Cleanup(func() { _ = f.Close() })
+	for _, transport := range []string{"udp", "tcp"} {
+		for _, local := range []bool{false, true} {
+			t.Run(fmt.Sprintf("%s/physical=%v", transport, local), func(t *testing.T) {
+				p0, n0 := physical.Load(), tailnet.Load()
+				r := &dnstype.Resolver{Addr: target.String()}
+				if local {
+					r = dnstype.PhysicalNetworkResolver(r)
+				}
+				fq := &forwardQuery{packet: request, txid: getTxID(request), family: transport, closeOnCtxDone: new(closePool)}
+				defer fq.closeOnCtxDone.Close()
+				ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+				defer cancel()
+				var got []byte
+				var err error
+				if transport == "udp" {
+					got, err = f.sendUDP(ctx, fq, resolverAndDelay{name: r})
+				} else {
+					got, err = f.sendTCP(ctx, fq, resolverAndDelay{name: r})
+				}
+				if err != nil || !bytes.Equal(got, response) {
+					t.Fatalf("bad DNS reply: %v", err)
+				}
+				if local {
+					if physical.Load() != p0+1 || tailnet.Load() != n0 {
+						t.Fatal("physical DNS used Tailnet")
+					}
+				} else if tailnet.Load() != n0+1 || physical.Load() != p0 {
+					t.Fatal("Tailnet DNS used physical network")
+				}
+			})
+		}
+	}
+}
