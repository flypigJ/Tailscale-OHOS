+func TestD3PrivateFailuresNeverUseRoot(t *testing.T) {
+	for _, family := range []string{"udp", "tcp"} {
+		t.Run(family, func(t *testing.T) {
+			root, split := d3Serve(t, false), d3Serve(t, true)
+			m, _ := d3Manager(t, root, split)
+			if err := m.Set(d3Config(split)); err != nil {
+				t.Fatal(err)
+			}
+			for _, typ := range []dns.Type{dns.TypeA, dns.TypeAAAA} {
+				for _, tc := range []struct {
+					prefix  string
+					code    dns.RCode
+					timeout bool
+				}{
+					{"ok", dns.RCodeSuccess, false}, {"nxdomain", dns.RCodeNameError, false},
+					{"servfail", dns.RCodeServerFailure, false}, {"refused", dns.RCodeRefused, false},
+					{"timeout", 0, true},
+				} {
+					name := tc.prefix + ".private.test."
+					reply, err := d3Query(m, name, typ, family)
+					if tc.timeout {
+						if err == nil && reply.RCode != dns.RCodeServerFailure {
+							t.Fatalf("silent private server unexpectedly answered: %+v", reply)
+						}
+					} else if err != nil || reply.RCode != tc.code {
+						t.Fatalf("%s %s: rcode=%v err=%v", family, name, reply.RCode, err)
+					}
+					if split.count(name) == 0 {
+						t.Fatalf("private query did not reach split server: %s", name)
+					}
+					if root.count(name) != 0 {
+						t.Fatalf("private query leaked to root: %s", name)
+					}
+					public := "after-" + tc.prefix + ".public.test."
+					p, e := d3Query(m, public, typ, family)
+					if e != nil || p.RCode != 0 || len(p.Answers) != 1 || root.count(public) == 0 || split.count(public) != 0 {
+						t.Fatalf("public query after %s failed: %v %+v", name, e, p)
+					}
+				}
+			}
+			name := "missing.magic.test."
+			p, e := d3Query(m, name, dns.TypeA, family)
+			if e != nil || p.RCode != dns.RCodeNameError || root.count(name) != 0 || split.count(name) != 0 {
+				t.Fatalf("authoritative empty route escaped: %v %+v", e, p)
+			}
+			p, e = d3Query(m, "tcp.private.test.", dns.TypeA, "tcp")
+			if e != nil || p.RCode != 0 || len(p.Answers) != 1 {
+				t.Fatalf("TCP retry failed: %v %+v", e, p)
+			}
+			split.mu.Lock()
+			tcpCount := split.tcp
+			split.mu.Unlock()
+			if tcpCount == 0 {
+				t.Fatal("TCP path was never exercised")
+			}
+		})
+	}
+}
