+// Exercise the wire DNSConfig format shared by control servers, including
+// null authoritative routes. This is not a live Headscale deployment test.
+func TestD3ControlDNSConfigAndExitContext(t *testing.T) {
+	var response tailcfg.MapResponse
+	payload := []byte(`{"DNSConfig":{"Proxied":true,"Domains":["mesh.test"],"Routes":{"private.test":[{"Addr":"100.64.0.53","UseWithExitNode":true}],"mesh.test":null},"ExtraRecords":[{"Name":"service.mesh.test","Type":"A","Value":"192.0.2.9"}]}}`)
+	if err := json.Unmarshal(payload, &response); err != nil {
+		t.Fatal(err)
+	}
+	if response.DNSConfig == nil {
+		t.Fatal("missing wire DNS config")
+	}
+	nm := &netmap.NetworkMap{DNS: *response.DNSConfig, SelfNode: (&tailcfg.Node{Name: "phone.mesh.test.", Addresses: []netip.Prefix{netip.MustParsePrefix("100.64.0.1/32")}}).View()}
+	for _, tc := range []struct {
+		name  string
+		prefs ipn.Prefs
+		exit  bool
+	}{
+		{"off", ipn.Prefs{CorpDNS: true}, false},
+		{"stable-id", ipn.Prefs{CorpDNS: true, ExitNodeID: "legacy"}, true},
+		{"legacy-ip", ipn.Prefs{CorpDNS: true, ExitNodeIP: netip.MustParseAddr("100.64.0.2")}, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			cfg := dnsConfigForNetmap(nm, nil, tc.prefs.View(), false, t.Logf, "openharmony")
+			if cfg.UsingExitNode != tc.exit {
+				t.Fatal("exit context does not match the prefs used for compilation")
+			}
+			rs, ok := cfg.Routes["private.test."]
+			if !ok || len(rs) != 1 || rs[0].Addr != "100.64.0.53" || rs[0].UsesPhysicalNetwork() {
+				t.Fatal("control split resolver changed provenance")
+			}
+			if rs, ok := cfg.Routes["mesh.test."]; !ok || len(rs) != 0 {
+				t.Fatal("null authoritative route lost")
+			}
+			if len(cfg.SearchDomains) != 1 || cfg.SearchDomains[0] != "mesh.test." {
+				t.Fatal("control search domain lost")
+			}
+			if len(cfg.Hosts["service.mesh.test."]) != 1 {
+				t.Fatal("extra record lost")
+			}
+		})
+	}
+}
