+func TestD3LocalProvenanceCannotBeDeserialized(t *testing.T) {
+	original := &Resolver{Addr: "192.0.2.53"}
+	local := PhysicalNetworkResolver(original)
+	if original.UsesPhysicalNetwork() || !local.UsesPhysicalNetwork() || original.Equal(local) {
+		t.Fatal("local provenance aliased or lost equality")
+	}
+	if !local.Clone().UsesPhysicalNetwork() || !local.View().AsStruct().UsesPhysicalNetwork() {
+		t.Fatal("clone/view lost provenance")
+	}
+	if local.WithoutPhysicalNetwork().UsesPhysicalNetwork() || !local.UsesPhysicalNetwork() {
+		t.Fatal("exit clone mutated original")
+	}
+	for _, marshal := range []func(any) ([]byte, error){json.Marshal, func(v any) ([]byte, error) { return jsonv2.Marshal(v) }} {
+		raw, e := marshal(local)
+		if e != nil || strings.Contains(strings.ToLower(string(raw)), "physical") {
+			t.Fatalf("local field serialized: %s %v", raw, e)
+		}
+	}
+	for _, unmarshal := range []func([]byte, any) error{json.Unmarshal, func(b []byte, v any) error { return jsonv2.Unmarshal(b, v) }} {
+		for _, field := range []string{"physicalNetwork", "PhysicalNetwork", "UsesPhysicalNetwork"} {
+			var r Resolver
+			raw := []byte(`{"Addr":"192.0.2.53","` + field + `":true}`)
+			if e := unmarshal(raw, &r); e != nil {
+				t.Fatal(e)
+			}
+			if r.UsesPhysicalNetwork() {
+				t.Fatal("remote JSON set local provenance")
+			}
+		}
+	}
+}
